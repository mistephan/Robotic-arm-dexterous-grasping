# Vendored SDK mirrors upstream — never edit in tree; regen from upstream + re-apply local patches
# (see sdk/README.md). The current in-tree copy IS the source of truth; if
# you need a clean re-vendor, delete sdk/reBotArm_control_py/ and re-clone.
# sdk/reBotArm_control_py/
# Local LinkHand runtime SDK (not committed; upstream snapshot has no LICENSE file).
sdk/linkerhand-python-sdk/

# Orbbec SDK runtime logs (regenerated on every camera run)
**/Log/OrbbecSDK.log.txt
**/Log/Orbbec*.log

# Per-launcher PID + log files (root owns these in dev)
.vllm_*.pid
.wrc_*.pid

# Local cleanup backup
.cleanup_backup/

# Teach-record/replay slot files (JSON recordings, .gitkeep stays tracked)
data/recordings/*.json

# Open-source release hygiene (2026-08-27)
# ----------------------------------------
# The checked-in hand-eye calibration is the DEMO default; it has been
# anonymized (camera_serial -> "REDACTED", samples_for_repro stripped).
# Local recalibration output goes to a *.local.json sidecar so the
# private camera_serial never lands in git history again:
data/calibration/hand_eye_top.local.json
data/calibration/hand_eye_wrist.local.json

# Blanket-ignore the bundled-models directory. The downloader script
# (scripts/setup_models.py) is the only blessed entry point.
# Files in models/ are tracked only if explicitly added (none expected).
models/*
!models/.gitkeep
!models/README.md

# Recursive SDK mirrors — never edit in tree; see sdk/README.md.
sdk/reBotArm_control_py/

# Editor / IDE scratch files
.vscode/
.idea/
*.swp
condaenv.*.requirements.txt


