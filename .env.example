# Example environment for wrc_demo LLM profiles.
# Copy to `.env` (gitignored) and fill in real values before launching
# any cloud-profile demo. Local profiles (local_qwen, local_cosmos3) do
# not need any of these. See ADR-0006.
#
# Usage:
#     cp .env.example .env
#     vim .env            # fill in the keys you have
#     set -a; source .env; set +a
#     python -m wrc_demo.apps.demo --llm minimax ...

# MiniMax (configs/llm/minimax.yaml) ------------------------------
# Required for --llm minimax. Get a key from the MiniMax dashboard.
# (Out of scope to link here; check the README's LLM section.)
MINIMAX_API_KEY=

# OpenAI (configs/llm/openai.yaml) --------------------------------
# Required for --llm openai. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (configs/llm/anthropic.yaml) ---------------------------
# Required for --llm anthropic. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Hugging Face (for `hf download nvidia/Cosmos3-Edge`) -------------
# Get a token from https://huggingface.co/settings/tokens
# Required write scope only if you intend to push quantized models
# back to HF (out of scope for ADR-0007; see SPEC-local-llm.md).
HF_TOKEN=
